+    def push_cache_to_hf(self, hf_repo: str, hf_token: str | None) -> None:
+        if not hf_repo or not hf_token or not self.use_cache or not self.cache_in_mem:
+            return
+        self.save_cache()
+        try:
+            from huggingface_hub import HfApi
+            HfApi(token=hf_token).upload_file(
