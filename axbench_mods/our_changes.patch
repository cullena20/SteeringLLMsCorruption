+    def _pull_cache_from_hf(self, hf_repo: str, hf_token: str | None) -> None:
+        if not hf_repo or not hf_token or not self.use_cache:
+            return
+        try:
+            from huggingface_hub import hf_hub_download
+            local = hf_hub_download(
